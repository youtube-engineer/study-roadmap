# 楽天ウェブサービスのアクセスキー。
# ポータルでは「access key」、APIのパラメータ名は applicationId。同じもの。
# https://webservice.rakuten.co.jp/ で登録する（無料・即発行）。
#
# 登録時の注意（CLAUDE.md 7章）:
#   応募タイプは必ず「ウェブアプリケーション」を選ぶこと。
#   「API/バックエンドサービス」を選ぶとIPアドレスでの許可リストになり、
#   Vercelのサーバーレスは送信元IPが動的なので詰む。
#
# これが空のあいだはモックデータで動く。入れた時点で楽天の経路に切り替わる。
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイトID（任意）。設定すると検索結果のリンクが成果対象になる。
# 自己購入は違反ではないが成果にならない。親族・知人による購入は明確に違反。
RAKUTEN_AFFILIATE_ID=

# ドメイン許可でサーバーサイドfetchが弾かれた場合だけ設定する。
# 登録したドメインを入れて Referer を明示的に送る。例: https://example.com/
RAKUTEN_REFERER=

# 公開URL。共有リンクの表示とOGPの絶対URLに使う。
# 例: https://example.com （末尾のスラッシュは付けない）
#
# Vercel なら空でよい。本番は固定の本番ドメイン、プレビューはそのデプロイのURLに
# 自動で解決される。独自ドメインを当てたらここに入れる。
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase
# https://supabase.com/dashboard の Project Settings → API Keys で確認する。
# ---------------------------------------------------------------------------

# プロジェクトのURL。例: https://xxxxxxxxxxxx.supabase.co
#
# ⚠ Vercel の Supabase 連携は SUPABASE_URL（NEXT_PUBLIC_ 無し）しか入れない。
# ブラウザ側で使うので **NEXT_PUBLIC_ 付きを自分で追加する必要がある**。
# これが無いとログインボタンを押しても何も起きない。
NEXT_PUBLIC_SUPABASE_URL=

# ブラウザに出してよい公開鍵（publishable / anon key）。
# RLSが効いている前提の鍵なので、露出すること自体は問題にならない。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RLSを無視できる秘密鍵（secret / service_role key）。
# **絶対に NEXT_PUBLIC_ を付けない。** books テーブルへの書き込みだけに使う。
#
# Vercel の Supabase 連携を使っている場合は SUPABASE_SERVICE_ROLE_KEY が
# 自動で入るので、こちらは空でよい（コード側が両方の名前を見る）。
SUPABASE_SECRET_KEY=
